[0m\u001b]8;;\u0007\u001b[23;1H\u001b[2K \u001b[38;5;5m\u001b[1mSignature: unsigned\u001b[22m                                                                                          \u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K \u001b[38;5;5m\u001b[1m\u001b[22m                                                                                                             \u001b[0m\u001b]8;;\u0007\u001b[25;1H\u001b[2K \u001b[38;5;5m\u001b[1mSkills instruct the model to run commands and code with your permissions. Review the SKILL.md after install.\u001b[22m\u001b[39m \u001b[0m\u001b]8;;\u0007\u001b[26;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[27;1H\u001b[2K \u001b[38;5;5m\u2192 \u001b[39m\u001b[38;5;5mYes\u001b[39m                                                                                                        \u001b[0m\u001b]8;;\u0007\u001b[28;1H\u001b[2K   \u001b[39mNo\u001b[39m                                                                                                         \u001b[0m\u001b]8;;\u0007\u001b[30;1H\u001b[2K \u001b[39m\u001b[2m\u2191\u2193\u001b[22;39m\u001b[39m\u001b[2m navigate\u001b[22;39m  \u001b[39m\u001b[2menter\u001b[22;39m\u001b[39m\u001b[2m select\u001b[22;39m  \u001b[39m\u001b[2mescape/ctrl+c\u001b[22;39m\u001b[39m\u001b[2m cancel\u001b[22;39m                                                              \u001b[0m\u001b]8;;\u0007\u001b[31;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[32;1H\u001b[2K\u001b[38;5;4m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
