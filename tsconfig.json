{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"types": ["node"],
		"lib": ["ES2023", "DOM"]
	},
	"include": ["src", "test", "examples"]
}
